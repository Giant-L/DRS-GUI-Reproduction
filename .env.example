UGROUND_API_KEY=EMPTY
UGROUND_MODEL=osunlp/UGround-V1-2B
UGROUND_TIMEOUT_SECONDS=120

# Local paths
SCREENSPOT_PRO_DIR=data/ScreenSpot-Pro
