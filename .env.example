# DeepSeek Vision smoke-test backend (not a paper-aligned baseline)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=120

# UGround OpenAI-compatible server (paper-aligned baseline)
UGROUND_API_BASE=http://localhost:8000/v1
UGROUND_API_KEY=EMPTY
UGROUND_MODEL=osunlp/UGround-V1-2B
UGROUND_TIMEOUT_SECONDS=120

# Remote OmniParser V2 + Instructor-large service reached through an SSH tunnel.
PERCEPTION_API_BASE=http://127.0.0.1:8010
PERCEPTION_API_KEY=replace-with-a-random-service-token
PERCEPTION_TIMEOUT_SECONDS=300
PERCEPTION_CACHE_DIR=tasks/perception_cache

# Local paths
SCREENSPOT_PRO_DIR=data/ScreenSpot-Pro
OUTPUT_DIR=outputs

# Optional: raises Hugging Face download rate limits. Leave empty for public access.
HF_TOKEN=
